{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "npm exec -- esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "tsx scripts/load-test.ts",
    "questions:generate": "tsx scripts/questions/generate.ts",
    "questions:generate-all": "tsx scripts/questions/generate-all.ts",
    "questions:audit": "tsx scripts/questions/audit-drafts.ts",
    "questions:revise": "tsx scripts/questions/revise-audited-drafts.ts",
    "questions:review-packets": "tsx scripts/questions/export-review-packets.ts",
    "questions:validate": "tsx scripts/questions/validate.ts",
    "questions:approve": "tsx scripts/questions/approve.ts",
    "questions:index": "tsx scripts/questions/build-index.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.182.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "openai": "^7.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
